<div class="box-form">
  <div class="left">
    <div style="height: 100px; width: 25%; margin-bottom: 20%;">
      <%= image_tag 'pos_display.png', alt: 'Description of image', :style => "width: 80%; object-fit: cover;" %>
    </div>
    <h4 style="text-align:center; font-weight: 600;">Login</h4>
    <br>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>
      <div class="fields">
        <b><%= f.label :email, class: "required-field", :style => "margin: 20px 0px 5px 10px;" %></b>
        <%= f.email_field :email, :required => true, class: "form-control", autocomplete: "email", style: "padding: 1.4rem 0.75rem;" %>
      </div>

      <div class="fields" style="margin-bottom: 2%;">
        <b><%= f.label :password, class: "required-field", :style => "margin: 20px 0px 5px 10px;" %></b>
        <%= f.password_field :password, :required => true, class: "form-control", autocomplete: "current-password", style: "padding: 1.4rem 0.75rem;" %>
      </div>
      <span style="margin-left: 3%;"><%= link_to "Forgot your password?", new_password_path(resource_name) %></span>
      <div class="form-check" style="margin: 10px 0px 0px 17px;">
        <% if devise_mapping.rememberable? %>
          <%= f.check_box :remember_me, :class => "form-check-input" %>
          <b><%= f.label :remember_me, :class => "form-check-label" %></b>
        <% end %>
      </div>
      <br>
      <div class="actions" align="center">
        <%= f.submit "Login", class: 'btn btn-success', style: "width: 50%; height: 60px; background: linear-gradient(30deg , #56d8e4 10%, #9f01ea 90%);" %>
      </div>
    <% end %>
    <br>
    <div>
      <hr>
    </div>
    <div align="center" style="margin-bottom: 48%;">
      <%= render "users/shared/links" %>
    </div>
  </div>
  
  <div class="right">
    <div class="overlay">
      <h1>Welcome Back!</h1>
      <p style="font-size: 20px; margin: 1% 0% 19% 0%;">
        <b>Serving smiles one order at a time. Ready to brew up some great orders?</b><br>
        <b>Login and start taking orders!</b>
      </p>
    </div>
  </div>
</div>