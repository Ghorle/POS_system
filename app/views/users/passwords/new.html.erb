<div class="box-form">
  <div class="left">
    <div style="height: 100px; width: 25%; margin-bottom: 20%;">
      <%= image_tag 'pos_display.png', alt: 'Description of image', :style => "width: 80%; object-fit: cover;" %>
    </div>
    <h4 style="text-align:center; font-weight: 600;">Send Password Reset Instructions</h4>
    <br>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>
      <div class="fields">
        <b><%= f.label :email, class: "required-field", :style => "margin: 20px 0px 5px 10px;" %></b>
        <%= f.email_field :email, :required => true, class: "form-control", autocomplete: "email", style: "padding: 1.4rem 0.75rem;" %>
      </div>
      <br>
      <div class="actions" align="center">
        <%= f.submit "Reset Password", class: 'btn btn-success', style: "width: 50%; height: 60px; background: linear-gradient(30deg , #56d8e4 10%, #9f01ea 90%);" %>
      </div>
    <% end %>
    <br>
    <div>
      <hr>
    </div>
    <div align="center" style="margin-bottom: 48%;">
      <%= render "users/shared/links" %>
    </div>
  </div>
  
  <div class="right">
    <div class="overlay">
      <h1>Don't Worry</h1>
      <p style="font-size: 20px; margin: 1% 0% 19% 0%;">
        <b>We'll help you get back on track!</b><br>
        <b>Enter your registered email to receive reset instructions.</b>
      </p>
    </div>
  </div>
</div>