<div class="box-form">
  <div class="left">
    <div style="height: 35px; width: 25%; margin: 10% 0% 20% 0%;">
      <%= image_tag 'pos_display.png', alt: 'Description of image', :style => "width: 80%; object-fit: cover;" %>
    </div>
    <h4 style="text-align:center; font-weight: 600;">Signup</h4>
    <br>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>
      <div class="fields">
        <b><%= f.label :name, class: "required-field", :style => "margin: 20px 0px 5px 10px;" %></b>
        <%= f.text_field :name, :required => true, class: "form-control", style: "padding: 1.4rem 0.75rem;" %>
      </div>
      <div class="fields">
        <b><%= f.label :email, class: "required-field", :style => "margin: 20px 0px 5px 10px;" %></b>
        <%= f.email_field :email, :required => true, class: "form-control", style: "padding: 1.4rem 0.75rem;" %>
      </div>

      <div class="fields">
        <b><%= f.label :password, class: "required-field", :style => "margin: 20px 0px 5px 10px;" %></b>
        <%= f.password_field :password, :required => true, class: "form-control", style: "padding: 1.4rem 0.75rem;", placeholder: "Minimum 6 characters" %>
      </div>

      <div class="fields">
        <b><%= f.label :password_confirmation, class: "required-field", :style => "margin: 20px 0px 5px 10px;" %></b>
        <%= f.password_field :password_confirmation, :required => true, class: "form-control", style: "padding: 1.4rem 0.75rem;", placeholder: "Minimum 6 characters" %>
      </div>
      <br>
      <div class="actions" align="center">
        <%= f.submit "Signup", class: 'btn btn-success', style: "width: 50%; height: 60px; background: linear-gradient(30deg , #56d8e4 10%, #9f01ea 90%);" %>
      </div>
    <% end %>
    <br>
    <div>
      <hr>
    </div>
    <div align="center" style="margin-bottom: 48%;">
      <%= render "users/shared/links" %>
    </div>
  </div>
  
  <div class="right">
    <div class="overlay">
      <h1>Join Our Café Community!</h1>
      <p style="font-size: 20px; margin: 1% 0% 19% 0%;">
        <b>Serving smiles one order at a time. Ready to brew up some great orders?</b><br>
        <b>Sign up to get started with our POS system.</b>
      </p>
    </div>
  </div>
</div>