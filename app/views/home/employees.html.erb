<div class="row justify-content-center">
  <div class="col-10" style="margin-top: 4%; padding: 1rem; border-radius: 10px">
    <span style="float: right;">
      <%= link_to 'Inactive Employees', inactive_employees_home_index_path, class: "btn btn-info", style: "font-size: 16px;font-weight: bold;margin-bottom: 5px; background: linear-gradient(30deg , pink 10%, red 90%);" %>
    </span>
    <h1 align="center" style="margin-bottom: 30px; font-size: 35px; font-weight: 600;">Active Employees</h1>
    <div style="border: 1px solid #cdcdcd; padding: 1rem; margin-bottom: 2%;">
      <span style="float: right;">
        <%= link_to 'Add Employee', '#', class: 'open-modal btn', style: "font-weight: bold;margin-bottom: 5px; background: linear-gradient(30deg , #2d61f1 10%, #9f01ea 90%);" %>
      </span>
      <div>
        <%= form_tag(employees_home_index_path, method: :get, remote: :true) do %>
          <%= text_field_tag(:search, params[:search], :placeholder => "Search by ID or Name", class: "form-control", :style => "background: #e0dddd; width: 800px;height:38px;display: inline-block;") %>
          <%= submit_tag ("Search"), :style => "width: 90px;height:38px;margin: 0px 0px 4px 1px;display: inline-block;", :class => "btn btn-success" %>
        <% end %>
      </div>
    </div>
    <table class="table table-striped table-hover">
      <thead style="background: linear-gradient(30deg , #2d61f1 10%, #9f01ea 90%);">
        <tr style="color: white; vertical-align: middle; text-align: center;">
          <th style="width: 10%;">Employee ID</th>
          <th style="width: 20%;">Employee Name</th>
          <th style="width: 20%;">Employee Email</th>
          <th style="width: 20%;">Total Orders Taken Today</th>
          <th style="width: 20%;">Total Orders Taken Overall</th>
          <th style="width: 20%;">Veiw</th>
        </tr>
      </thead>
      <% if @employees.present? %>
        <tbody style="background: white;">
          <% @employees.each do |employee| %>
            <tr style="text-align: center">
              <td><%= employee.id %></td>
              <td><%= employee.name %></td>
              <td><%= employee.email %></td>
              <td><%= employee.my_orders.current_days.count %></td>
              <td><%= employee.my_orders.count %></td>
              <td><button class="open-modal button-71" data-user-id="<%= employee.id %>">view</button></td>
            </tr>
          <% end %>
        </tbody>
      <% else %>
        <tbody>
            <tr style="text-align: center">
              <td colspan="7"><b>No Record Found</b></td>
            </tr>
        </tbody>
      <% end %>
    </table>
    <!-- Modal Structure -->
    <div id="modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h1 align="center" style="margin-bottom: 30px; font-size: 26px; font-weight: 600;">Employee</h1>
        <div style="padding: 0px 40px 0px 40px;">
          <%= form_with model: @employee, url: add_employee_home_index_path, method: :get, local: true do |form| %>
            <div class="field">
              <%= form.label :name, :style => "margin: 10px 0px 0px 10px;" %>
              <%= form.text_field :name, :placeholder => "Name", class: "form-control" %>
            </div>
            <div class="field">
              <%= form.label :email, :style => "margin: 10px 0px 0px 10px;" %>
              <%= form.text_field :email, :placeholder => "Email", class: "form-control", autofocus: true %>
            </div>
            <br>
            <div class="actions" align="center">
              <%= form.submit 'Add Employee', class: 'btn btn-success', style: "width: 50%; background: linear-gradient(30deg , #147917 10%, #33A036 90%);" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <!-- Modal Structure -->
    <div id="user-modal" class="modal">
      <div class="modal-content">
        <span class="close2">&times;</span>
        <div id="modal-user-details"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('modal');
    const openBtn = document.querySelector('.open-modal');
    const closeBtn = document.querySelector('.close');

    openBtn.addEventListener('click', (event) => {
      event.preventDefault();
      modal.style.display = 'block';
    });

    closeBtn.addEventListener('click', () => {
      modal.style.display = 'none';
    });

    window.addEventListener('click', (event) => {
      if (event.target == modal) {
        modal.style.display = 'none';
      }
    });
  });
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('user-modal');
    const closeBtn = document.querySelector('.close2');

    document.querySelectorAll('.open-modal').forEach(button => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        const userId = button.getAttribute('data-user-id');
        
        fetch(`/home/employee?id=${userId}`)
          .then(response => response.json())
          .then(user => {
            const modalUserDetails = document.getElementById('modal-user-details');
            modalUserDetails.innerHTML = `
              <h2>${user.name}</h2>
              <p>Email: ${user.email}</p>
              <p>Passcode: ${user.passcode}</p>
              <p>Status: ${user.status}</p>
            `;
            modal.style.display = 'block';
          })
          .catch(error => console.error('Error:', error));
      });
    });

    closeBtn.addEventListener('click', () => {
      modal.style.display = 'none';
    });

    window.addEventListener('click', (event) => {
      if (event.target == modal) {
        modal.style.display = 'none';
      }
    });
  });
</script>