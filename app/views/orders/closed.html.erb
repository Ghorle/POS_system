<div class="row justify-content-center">
  <div class="col-11" style="margin-top: 2%; padding: 1rem; border-radius: 10px">
    <h1 align="center" style="margin-bottom: 30px; font-size: 35px; font-weight: 600;">Closed Orders</h1>
    <div style="border: 1px solid #cdcdcd; padding: 1rem; margin-bottom: 2%;">
      <%= form_tag(closed_orders_path, method: :get, remote: :true) do %>
        <%= text_field_tag(:search, params[:search], :placeholder => "Search by ID or Customer Name", class: "form-control", style: "background: #e0dddd; width: 30%;height:38px;display: inline-block;") %>
        <%= submit_tag ("Search"), :style => "width: 90px;height:38px;margin: 0px 0px 4px 1px;display: inline-block;", :class => "btn btn-success" %>
      <% end %>
    </div>
    <table class="table table-striped table-hover">
      <thead style="background: linear-gradient(30deg , #2d61f1 10%, #9f01ea 90%);">
        <tr style="color: white; text-align: center">
          <th>Order</th>
          <th>Type</th>
          <th>Status</th>
          <th>Customer Name</th>
          <th>Customer Contact</th>
          <th>Employee Name</th>
          <th>Total Amount</th>
        </tr>
      </thead>
    <% if @orders.present? %>
      <tbody>
        <% @orders.each do |order| %>
          <tr style="vertical-align: middle; text-align: center;">
            <td><%= order.id %></td>
            <td><%= order.order_type&.humanize %></td>
            <td><%= order.status&.humanize %></td>
            <td><%= link_to order.customer_name, order %></td>
            <td><%= order.customer_contact %></td>
            <td><%= order.employee.name %></td>
            <td><%= order.payable_total&.round(2) %></td>
          </tr>
        <% end %>
      </tbody>
    <% else %>
      <tbody>
          <tr style="text-align: center">
            <td colspan="7"><b>No Record Found</b></td>
          </tr>
      </tbody>
    <% end %>
    </table>

    <br>

    <%= link_to 'Back', :back, class: "btn btn-dark" %>
  </div>
</div>