<div class="row justify-content-center">
  <div class="col-10" style="margin-top: 4%; border: 1px solid #cdcdcd; margin-bottom: 2%; padding: 1rem; border-radius: 10px">
    <p>
      <span style="float: right;">
        <%= link_to ('<i class="fa-solid fa-edit fa-xl"></i>').html_safe, edit_order_path(@order), class: "btn" %>
      </span>
      <h2 align="center" style="margin-bottom: 30px; font-size: 35px; font-weight: 600;">Order no: <%= @order.id %></h2>
    </p>
    <p>
      <div class="mb-10 row">
        <div class="col-sm-4 col-form-label">
          <strong>Customer Name:</strong>
          <%= @order.customer_name %>
        </div>
        <div class="col-sm-4 col-form-label">
          <strong>Customer Contact:</strong>
          <%= @order.customer_contact %>
        </div>
      </div>
      <div class="mb-10 row">
        <div class="col-sm-4 col-form-label">
          <strong>Employee Name:</strong>
          <%= @order.employee.name %>
        </div>
        <div class="col-sm-4 col-form-label">
          <strong>Order Type:</strong>
          <%= @order.order_type&.humanize %>
        </div>
      </div>
      <br>
    </p>
    <div align="center">
      <table class="table table-striped table-hover" style="width: 90%">
        <thead style="background: linear-gradient(30deg , #2d61f1 10%, #9f01ea 90%);">
          <tr style="color: white; text-align: center">
            <th style="width: 12%;">Name</th>
            <th style="width: 20%;">Description</th>
            <th style="width: 6%;">Price</th>
            <th style="width: 1%;">Quantity</th>
            <th style="width: 6%;">Tax</th>
            <th style="width: 6%;">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_products.each do |product| %>
            <tr style="vertical-align: middle; text-align: center;">
              <td><%= product.name %></td>
              <td><%= product.description %></td>
              <td><%= product.price&.round(2) %></td>
              <td><%= product.qty&.round(2) %></td>
              <td><%= (product.tax*product.qty)&.round(2) %></td>
              <td><%= (product.price*product.qty)&.round(2) %></td>
            </tr>
          <% end %>
          <tr style="vertical-align: middle; text-align: center;">
            <td colspan="4"></td>
            <td><b><%= @order.tax&.round(2) %></b></td>
            <td><b><%= @order.gross_total&.round(2) %></b></td>
          </tr>
          <tr style="vertical-align: middle; text-align: center;">
            <td colspan="4"></td>
            <td colspan="2" align="center"><b style="color: green; font-size: 22px;"><%= @order.payable_total&.round(2) %></b></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>