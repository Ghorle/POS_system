<tr class="nested-fields">
  <td style="width: 27%"><%= f.select :raw_material_id, RawMaterial.order(:name).collect { |p| [p.name, p.id]}, {:include_blank => 'Type ingredient name...'}, :required => true, :style => "width: 100%;height:35px", class: "select-dropdown product" %></td>
  <td style="width: 10%"><%= f.number_field :quantity, :min => 1, placeholder: "Quantity", :required => true, class: "quantity" %></td>
  <td><%= link_to_remove_association '<i class="fas fa-xmark fa-xl"></i>'.html_safe, f, style: "color: black", class: "remove-nested" %></td>
</tr>