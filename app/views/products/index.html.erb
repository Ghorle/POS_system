<div class="row justify-content-center">
  <div class="col-10" style="margin-top: 2%; padding: 1rem; border-radius: 10px">
    <h1 align="center" style="margin-bottom: 30px; font-size: 35px; font-weight: 600;">Products</h1>
    <div style="border: 1px solid #cdcdcd; padding: 1rem; margin-bottom: 2%;">
      <span style="float: right;">
        <%= link_to 'Add New Product', '#', class: "open-modal btn btn-success", style: "font-size: 20px;font-weight: bold;margin-bottom: 5px; background: linear-gradient(30deg , #2d61f1 10%, #9f01ea 90%);" %>
      </span>
      <div>
        <%= form_tag(products_path, method: :get, remote: :true) do %>
          <%= text_field_tag(:search, params[:search], :placeholder => "Search by ID or Name",class: "form-control", :style => "background: #e0dddd; width: 800px;height:38px;display: inline-block;") %>
          <%= submit_tag ("Search"), :style => "width: 90px;height:38px;margin: 0px 0px 4px 1px;display: inline-block;", :class => "btn btn-success" %>
        <% end %>
      </div>
    </div>
    <table class="table table-striped table-hover" >
      <thead style="background: linear-gradient(30deg , #2d61f1 10%, #9f01ea 90%);">
        <tr style="color: white; text-align: center">
          <th style="width: 5%;">ID</th>
          <th style="width: 5%;">Image</th>
          <th style="width: 16%;">Name</th>
          <th style="width: 32%;">Description</th>
          <th style="width: 7%;">Price</th>
          <th style="width: 0%;"></th>
        </tr>
      </thead>
      <% if @products.present? %>
        <tbody>
          <%= render @products %>
        </tbody>
      <% else %>
        <tbody>
          <tr style="text-align: center">
            <td colspan="6"><b>No Record Found</b></td>
          </tr>
        </tbody>
      <% end %>
    </table>

    <!-- Modal Structure -->
    <div id="modal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h1 align="center" style="margin-bottom: 30px; font-size: 26px; font-weight: 600;">Product</h1>
        <div style="padding: 0px 40px 0px 40px;">
          <%= form_with model: @product, url: products_path, local: true do |form| %>
            <div class="field col-9">
              <b><%= form.label :product_images, "Upload Product Image", :style => "margin: 10px 0px 0px 10px;" %></b>
              <%= form.file_field :product_images, multiple: true, class: "form-control", :style => "width: 50%;margin: 5px 0px 0px 0px;display: inline-block;", title: "Product Image" %>
            </div>
            <div class="field">
              <b><%= form.label :name, class: "required-field", :style => "margin: 10px 34px 0px 10px;" %></b>
              <%= form.text_field :name, :required => true, :style => "width: 45%;" %><br>
              
              <b><%= form.label :price, class: "required-field", :style => "margin: 10px 39px 0px 10px;" %></b>
              <%= form.number_field :price, step: '0.01', :required => true, style: "width: 20%; " %><br>
            </div>
            <div class="form-group">
              <b><%= form.label :description %></b>
              <%= form.text_area :description, class: 'form-control' %>
            </div>
            <br>
            <div class="actions" align="center">
              <%= form.submit 'Add Product', class: 'btn btn-success', style: "width: 50%; background: linear-gradient(30deg , #147917 10%, #33A036 90%);" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    
    <div class="container pagination justify-content-center">
      <%= paginate @products %>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('modal');
    const openBtn = document.querySelector('.open-modal');
    const closeBtn = document.querySelector('.close');

    openBtn.addEventListener('click', (event) => {
      event.preventDefault();
      modal.style.display = 'block';
    });

    closeBtn.addEventListener('click', () => {
      modal.style.display = 'none';
    });

    window.addEventListener('click', (event) => {
      if (event.target == modal) {
        modal.style.display = 'none';
      }
    });
  });
</script>