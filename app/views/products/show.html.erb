<div class="row justify-content-center">
  <div class="col-8" style="margin-top: 4%; border: 1px solid #cdcdcd; margin-bottom: 2%; padding: 1rem; border-radius: 10px; background: linear-gradient(30deg , #b3caf3 5%, #d7b8f3 95%);">
    <div class="mt-3">
      <span style="float: right;">
        <%= link_to ('<i class="fa-solid fa-edit fa-xl"></i>').html_safe, edit_product_path(@product), class: "btn" %>
      </span>
      <h1 align="center" style="margin-bottom: 30px;">Product - <%= @product.id %></h1>
    </div>
    
    <div class="mb-10 row">
      <div class="col-sm-4 col-form-label">
        <strong>Name:</strong>
        <%= @product.name %>
      </div>
      <div class="col-sm-4 col-form-label">
        <strong>Price:</strong>
        <%= @product.price %>
      </div>
    </div>

    <div class="col-sm-12 col-form-label">
      <strong>Description:</strong>
      <%= @product.description %>
    </div>
    <hr>
    <% if @product.product_images.present? %>
      <% @product.product_images.each do |image| %>
        <%= image_tag image, :class => "show-img" %>
      <% end %>
    <% else%>
      <h2 style="border: 1px solid; border-radius: 15px; width: 200px; padding: 20px">No Image</h2>
    <% end %>
    <hr>
    <h2>Ingredients</h2>
    <% if @product.ingredients.exists? %>
      <% @product.ingredients.each_with_index do |ingredient, index| %>
        <b><%= ingredient.raw_material.name %></b>: <%= ingredient.quantity&.round(2) %>
        <% if index < @product.ingredients.size - 1 %>
          , 
        <% else %>
          .
        <% end %>
      <% end %>
    <% else %>
      <b>NA</b>
    <% end %>
  </div>
</div>


