<%= form_with(model: product, local: true) do |form| %>
  <% if product.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(product.errors.count, "error") %> </h2>

      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field col-9">
    <% if form.object.product_images.present? %>
      <%= image_tag form.object.product_images.last, :class => "show-img", :style => "margin-left: 10px;" %><br>
    <% end %>
    <b><%= form.label :product_images, "Upload Product Image", :style => "margin: 10px 0px 0px 10px;" %></b>
    <%= form.file_field :product_images, multiple: true, class: "form-control", :style => "width: 50%;margin: 5px 0px 0px 0px;display: inline-block;", title: "Product Image" %>
  </div>

  <div class="field">
    <b><%= form.label :name, class: "required-field", :style => "margin: 10px 34px 0px 10px;" %></b>
    <%= form.text_field :name, :required => true, :style => "width: 45%;" %><br>
    
    <b><%= form.label :price, class: "required-field", :style => "margin: 10px 39px 0px 10px;" %></b>
    <%= form.number_field :price, :required => true, style: "width: 20%; " %><br>
  </div>

  <div class="field">
    <b><%= form.label :description, :style => "margin: 10px 39px 0px 10px;" %></b>
    <%= form.text_area :description, class: 'form-control', :style => "width: 80%; margin-left: 1%" %>
  </div>
  <hr style="border: 5px solid; border-radius: 5px;">

  <div id="ingredients">
    <% if form.object.ingredients.present? %>
      <table style="border: 0px solid;">
        <thead>
          <tr style="text-align: center">
            <th style="width: 27%">Ingredient</th>
            <th style="width: 9%">Quantity</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= form.fields_for :ingredients do |ingredient_form| %>
            <%= render "ingredient_fields", f: ingredient_form %>
          <% end %>
        </tbody>
      </table> 
    <% end %>
    <div class='links' align="right">
      <%= link_to_add_association 'Add Ingredient', form, :ingredients, class:"btn", style: "color: white; background: linear-gradient(30deg , #6972e9 10%, #998bf5 90%);" %>
    </div>
  </div>

  <div class="actions" align="center" style="margin: 20px 0px 0px 20px;">
    <%= form.submit class: 'btn btn-success', style: "width: 25%;" %>
  </div>
<% end %>

<script>
  $('a.remove-nested').first().hide()
</script>
